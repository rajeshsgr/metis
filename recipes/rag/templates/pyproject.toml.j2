[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    {% if llm == "openai" %}"openai>=1.0",{% else %}"anthropic>=0.30",{% endif %}
    {% if embedding == "openai" %}"openai>=1.0",{% else %}"sentence-transformers>=3.0",{% endif %}
    {% if vector_db == "qdrant" %}"qdrant-client>=1.0"{% else %}"chromadb>=0.5"{% endif %}
]

[project.optional-dependencies]
dev = ["httpx>=0.27", "pytest>=8.0"]