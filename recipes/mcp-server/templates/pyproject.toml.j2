[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "mcp>=1.0,<2.0",
{% if transport == "streamable-http" %}    "fastapi>=0.115",
{% endif %}]

[project.optional-dependencies]
dev = ["pytest>=8.0"]