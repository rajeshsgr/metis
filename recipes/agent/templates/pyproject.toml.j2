[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    {% if llm == "openai" %}"openai>=1.0",{% else %}"anthropic>=0.30",{% endif %}
    {% if agent_runtime == "langgraph" %}"langgraph>=0.3",{% endif %}
    {% if state == "redis" %}"redis>=5.0",{% endif %}
]

[project.optional-dependencies]
dev = ["httpx>=0.27", "pytest>=8.0"]
