import os
from dataclasses import dataclass


@dataclass(frozen=True)
class Settings:
    project_name: str = os.getenv("PROJECT_NAME", "{{ project_name }}")
    llm: str = "{{ llm }}"
    agent_runtime: str = "{{ agent_runtime }}"
    state: str = "{{ state }}"
    redis_url: str = os.getenv("REDIS_URL", "redis://redis:6379")


settings = Settings()
