{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "questions", "template"],
  "properties": {
    "apiVersion": {"type": "string"},
    "kind": {"const": "Recipe"},
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {"defaultName": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "message", "options"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"const": "select"},
          "message": {"type": "string", "minLength": 1},
          "default": {"type": "string"},
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "template": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}